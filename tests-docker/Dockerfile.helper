# Helper image: real `pocketshell` CLI + stub agent CLIs + seeded fixtures.
#
# This is the PRIMARY end-to-end test target (port 3205). It installs the real
# server-side `pocketshell` helper (via uv) so the desktop app exercises the
# actual `pocketshell sessions list` / `usage` code paths, and
# stubs the provider CLIs (claude/codex/opencode/quse) with deterministic
# fixtures so no real credentials or network are needed.
#
# Extends pocketshell-test:tmux (=> pocketshell-test:ssh + tmux).
FROM pocketshell-test:tmux

# python3 + pip + uv for installing the real helper. git for `repos` later.
RUN apk add --no-cache python3 py3-pip git bash \
    && python3 -m pip install --break-system-packages --no-cache-dir uv

# Install the real pocketshell helper + its tmuxctl runtime dependency.
# `uv tool install` puts each tool in its OWN isolated venv and only symlinks
# the named package's entrypoints to ~/.local/bin — so pocketshell's
# `shutil.which("tmuxctl")` finds nothing unless tmuxctl is installed as its
# own tool too. Install both so their CLIs land on PATH.
#
# PIN THE VERSION. This was previously an unpinned `uv tool install
# pocketshell`, which does not mean "latest" — it means "whatever was latest
# when this layer was first cached". The image sat at 0.4.8 while real hosts
# ran 0.4.44, so integration and E2E never exercised what users actually run,
# and four parser bugs reached the app that way (a `{profiles: [...]}`
# envelope, a null `percent_remaining`, a removed `--json` flag, and a
# fixed-width table whose columns overflow). Bump this deliberately
# and re-capture the fixtures under tests/unit/fixtures/ when you do.
ARG POCKETSHELL_VERSION=0.4.44
RUN su testuser -c "uv tool install 'pocketshell==${POCKETSHELL_VERSION}' && uv tool install tmuxctl" \
    && mkdir -p /home/testuser/.local/bin

ENV PATH="/home/testuser/.local/bin:${PATH}"

# Stub provider CLIs + quse with deterministic, credential-free output.
COPY agent-bin/ /usr/local/bin/
RUN chmod +x /usr/local/bin/claude /usr/local/bin/codex /usr/local/bin/opencode /usr/local/bin/quse

# The seeded agent-conversation transcripts are gone with the Conversation
# feature (docs/WORKSPACE.md §9) — nothing reads them any more.
COPY fixtures/ /opt/pocketshell-fixtures/
COPY helper-entrypoint.sh /usr/local/bin/pocketshell-helper-entrypoint
RUN chmod +x /usr/local/bin/pocketshell-helper-entrypoint

EXPOSE 22

# The entrypoint starts sshd in the foreground AND seeds two live tmux sessions
# (so `pocketshell sessions list` returns a non-empty tree) as the testuser.
CMD ["/usr/local/bin/pocketshell-helper-entrypoint"]
